{
  "name": "nutaan-code",
  "version": "0.1.55",
  "description": "Nutaan Code — a personal AI coding agent desktop app",
  "main": "main.js",
  "private": true,
  "author": "Tecosys",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Tecosys/Nutaan-Code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tecosys/Nutaan-Code.git"
  },
  "bugs": {
    "url": "https://github.com/Tecosys/Nutaan-Code/issues"
  },
  "scripts": {
    "start": "node bin/nutaan-code.js",
    "build:icon": "node scripts/build-icon.js",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder --win --mac --linux",
    "release": "electron-builder --win --publish always",
    "release:mac": "electron-builder --mac --publish always",
    "release:linux": "electron-builder --linux --publish always",
    "start:raw": "electron ."
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.3.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^25.1.8",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.tecosys.nutaancode",
    "productName": "Nutaan Code",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "bin/**/*",
      "main.js",
      "preload.js",
      "arsenal/**/*",
      "agents/**/*",
      "tools/**/*",
      "renderer/**/*",
      "skills/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": false,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/logo.png",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "Nutaan Code opens and organises files you point it at.",
        "NSDocumentsFolderUsageDescription": "Nutaan Code opens and organises files you point it at.",
        "NSDownloadsFolderUsageDescription": "Nutaan Code opens and organises files you point it at."
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/logo.png",
      "category": "Development",
      "maintainer": "Tecosys",
      "synopsis": "AI coding agent desktop app",
      "desktop": {
        "StartupWMClass": "Nutaan Code"
      }
    },
    "deb": {
      "afterRemove": "build/linux-after-remove.sh"
    },
    "rpm": {
      "afterRemove": "build/linux-after-remove.sh"
    },
    "publish": {
      "provider": "github",
      "owner": "Tecosys",
      "repo": "Nutaan-Code",
      "releaseType": "draft"
    },
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ]
  },
  "bin": {
    "nutaan-code": "bin/nutaan-code.js"
  }
}
